{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|avif|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    { "source": "/reserva", "destination": "/reservations", "permanent": false },
    { "source": "/carta", "destination": "/menu", "permanent": false },
    { "source": "/sobre-nosotros", "destination": "/about", "permanent": false },
    { "source": "/galeria", "destination": "/gallery", "permanent": false },
    { "source": "/contacto", "destination": "/contact", "permanent": false }
  ]
}
